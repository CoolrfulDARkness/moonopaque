name = "CoolrfulDARkness/moonopaque"

version = "0.1.0"

readme = "README.mbt.md"

repository = "https://github.com/CoolrfulDARkness/moonopaque"

license = "Apache-2.0"

keywords = [
  "opaque",
  "apake",
  "rfc9807",
  "rfc9497",
  "oprf",
  "ristretto255",
  "p256",
  "cryptography",
  "pake",
]

preferred_target = "wasm"

description = "Pure MoonBit, zero-FFI implementation of IETF RFC 9807 OPAQUE (Augmented PAKE) with OPAQUE-Ristretto255-SHA512 and OPAQUE-P256-SHA256."
